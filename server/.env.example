# ---- Required ----
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://jobapp:CHANGE_ME@localhost:5432/jobcards
# Long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Public address of the app (used in the status link sent to customers)
PUBLIC_BASE_URL=https://jobs.mobike360.com

# Leave false when Nginx serves client/dist. Set true for Docker/Coolify (Express serves the React app).
SERVE_CLIENT=false
# CORS_ORIGIN=https://jobs.mobike360.com
# JWT_EXPIRES_IN=12h

# Folder for uploaded photos / receipts (back it up with the database)
UPLOAD_DIR=/home/ramana/jobcard-uploads

# ---- WhatsApp (Meta WhatsApp Cloud API) ----
# console = just print messages in the worker log (for testing)
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# template = use approved message templates (needed for messages you start)
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_PREFIX=jobcard_
# Language code of your English templates (en or en_US - must match what you created in Meta)
WHATSAPP_LANG_EN=en

# ---- SMS (Notify.lk) ----
# console | notifylk
SMS_PROVIDER=console
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# ---- Worker ----
WORKER_INTERVAL_MS=5000
NOTIFY_MAX_ATTEMPTS=4
